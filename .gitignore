*.swp
.DS_Store

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
# terraform.tfvars は非秘密のクラスタ構成情報として Git 管理する。
# 秘密情報(APIトークン等)は *.auto.tfvars (例: secret.auto.tfvars) に分離し、そちらのみ除外する。
terraform/*.auto.tfvars
crash.log
crash.*.log

# Ansible
ansible/*.retry
# k8s-manifests(private repo) 読み取り用 GitHub PAT。secrets.yml.example をコピーして作成する。
ansible/inventory/home/group_vars/all/secrets.yml
