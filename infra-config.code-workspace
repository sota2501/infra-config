{
  // VSCode の Ansible 拡張機能(ansible-lint 等)は、開いているファイルが属する
  // "ワークスペースフォルダ" を作業ディレクトリとしてツールを実行する。
  // ansible.cfg は ansible/ 配下にしか無い(CLI と同じくリポジトリ直下には置かない)ため、
  // マルチルートワークスペースとして ansible/ を独立フォルダに登録し、
  // 拡張機能がそこを cwd として ansible.cfg / .ansible-lint を正しく見つけられるようにする。
  //
  // 使い方: このファイルを VSCode で開く(File > Open Workspace from File...)。
  // リポジトリを普通にフォルダとして開く場合はこの恩恵を受けられないので注意。
  "folders": [
    { "name": "infra-config", "path": "." },
    { "name": "ansible", "path": "ansible" }
  ]
}
