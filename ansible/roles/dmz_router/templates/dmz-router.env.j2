{{ ansible_managed | comment }}
# dmz-router eBPFプログラムのattach/detachスクリプトが読む環境ファイル。
# ebpf-dmz-router:docs/specs/ebpf-program.md「設定項目(attachスクリプト)」。
MODE=attach
PIN_PATH={{ dmz_router_pin_path }}
BPF_OBJ={{ dmz_router_bpf_obj_path }}
PIN_GID={{ dmz_router_pin_gid }}
BPFTOOL={{ dmz_router_bpftool }}
