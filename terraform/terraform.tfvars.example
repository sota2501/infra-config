# このファイルを terraform.tfvars にコピーして実環境の値を埋める。
# terraform.tfvars は .gitignore 対象なので Git には含まれない。

proxmox_endpoint     = "https://proxmox.local:8006/"
proxmox_api_token    = "terraform@pve!terraform-token=00000000-0000-0000-0000-000000000000"
proxmox_tls_insecure = true
proxmox_node         = "pve"

vm_template_id    = 9000 # 事前に用意した cloud-init 対応テンプレートの VM ID
vm_datastore_id   = "local-lvm"
vm_network_bridge = "vmbr0"

# ssh_public_key は明示指定しなければ github_username の公開鍵
# (https://github.com/<user>.keys) を自動取得する。両方指定した場合は ssh_public_key が優先。
# ssh_public_key = "ssh-ed25519 AAAA... user@example.com"
github_username = "your-github-username"

network_gateway = "192.168.1.1"

control_plane_nodes = {
  "cp-1" = {
    vm_id   = 8101
    cores   = 2
    memory  = 4096
    disk_gb = 40
    ip_cidr = "192.168.1.11/24"
    # node_name = "pve2" # 複数 Proxmox ノードに分散する場合のみ、proxmox_node を上書き
  }
}

worker_nodes = {
  "worker-1" = {
    vm_id   = 8111
    cores   = 4
    memory  = 8192
    disk_gb = 80
    ip_cidr = "192.168.1.21/24"
  }
  "worker-2" = {
    vm_id   = 8112
    cores   = 4
    memory  = 8192
    disk_gb = 80
    ip_cidr = "192.168.1.22/24"
  }
}
